# No secrets required. Defaults to localhost; Vercel uses VERCEL_URL automatically.
# Optional: independent preview origin only, never cefedep.com.
SITE_URL=http://localhost:3000

# Google Analytics 4 — Measurement ID (ej: G-XXXXXXXXXX).
# Dejar vacío en preview/staging para evitar contaminar las métricas de producción.
NEXT_PUBLIC_GA_ID=
